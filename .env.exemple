# Copier en `.env` (jamais committé). Aucune valeur en dur dans le code.
SORARE_API_KEY=
SORARE_JWT=
SORARE_JWT_AUD=

# `vitrine quotidien` — alertes Gmail. Absents = pas de mail, un avertissement
# s'affiche à la place. GMAIL_MOT_DE_PASSE_APPLICATION est un mot de passe
# d'application (généré depuis les paramètres de sécurité du compte Google) :
# un mot de passe de compte normal ne fonctionne pas et ne doit pas être utilisé.
GMAIL_EXPEDITEUR=
GMAIL_MOT_DE_PASSE_APPLICATION=
GMAIL_DESTINATAIRE=
